---
import "../styles/index.css";
import "@fontsource-variable/roboto/wght.css";
import "@fontsource-variable/noto-sans/wght.css";
import "@fontsource-variable/noto-sans-jp/wght.css";
import "@fontsource-variable/noto-sans-tc/wght.css";
import "@fontsource-variable/noto-sans-sc/wght.css";
import "@fontsource-variable/noto-sans-kr/wght.css";
import { ClientRouter } from "astro:transitions";
import { LOCALES, localeFromPath, localePath, localeTag, type Locale } from "../i18n/locales";
import { t } from "../i18n/messages";
import { createServerI18nContext, serializeI18nSeed } from "../i18n/server";
import { canonicalPath, pageDescription, pageStructuredData, shouldNoindex } from "../lib/seo";
interface Props {
  locale: Locale;
  title: string;
  titleKey?: string;
  description?: string;
  route: string;
  /** Public canonical path when the logical page route is server-first. */
  canonicalRoute?: string;
  noindex?: boolean;
  seoTitleValues?: Partial<Record<Locale, string>>;
  seoDescriptionValues?: Partial<Record<Locale, string>>;
}
const { locale, title, titleKey, description, route, canonicalRoute, seoTitleValues, seoDescriptionValues } = Astro.props;
const noindex = Astro.props.noindex || shouldNoindex(route);
const origin = Astro.site?.origin ?? "https://haneoka.org";
const formatTitle = (value: string) => (value === "haneoka" ? value : `${value} · haneoka`);
const isLocalizedRoute = canonicalRoute
  ? localeFromPath(canonicalRoute) !== undefined
  : localeFromPath(Astro.url.pathname) !== undefined;
// Catalogue pages spell out where they sit: "楽曲 · カタログ · haneoka".
const withCatalogHierarchy = (target: Locale, value: string) => {
  if (!route.startsWith("/catalog/") || route === "/catalog") return value;
  const hub = t(target, "catalog", "Catalog");
  return value.includes(` · ${hub} ·`) || value.endsWith(` · ${hub}`) ? value : `${value} · ${hub}`;
};
const localizedTitle = seoTitleValues?.[locale] ?? (titleKey ? t(locale, titleKey, title) : title);
const fullTitle = formatTitle(withCatalogHierarchy(locale, localizedTitle));
const customDescription = description?.trim() && description.trim() !== title.trim() ? description : undefined;
const pageSummary = seoDescriptionValues?.[locale] ?? customDescription ?? pageDescription(locale, route, localizedTitle);
const publicRoute = canonicalRoute ?? (isLocalizedRoute ? localePath(route, locale) : route);
// Each locale's page canonicalizes to itself and points at its language
// siblings, so every language can rank on its own URL.
const canonicalHref = isLocalizedRoute
  ? `${origin}${canonicalPath(publicRoute)}`
  : `${origin}${canonicalPath(route)}`;
const languageAlternates = isLocalizedRoute
  ? LOCALES.map((target) => ({
      locale: target,
      href: `${origin}${canonicalPath(canonicalRoute ? localePath(publicRoute, target) : localePath(route, target))}`,
    }))
  : [];
const structuredData = JSON.stringify(
  pageStructuredData(origin, route, locale, fullTitle, pageSummary, isLocalizedRoute, publicRoute),
).replaceAll("<", "\\u003c");
const i18nSeed = serializeI18nSeed(createServerI18nContext(locale, route).seed());
---

<!doctype html>
<html lang={localeTag(locale)} data-locale={locale} data-seed="haneoka" transition:animate="none">
  <head>
    <style is:inline>
      @layer tokens, reset, base, layout, components, shell, patterns, pages, utilities, accessibility;
    </style>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script id="haneoka-i18n-seed" type="application/json" is:inline set:html={i18nSeed}></script>
    <script is:inline>
      if (!window.__haneokaDetailHistoryHook) {
        window.__haneokaDetailHistoryHook = true;
        window.addEventListener(
          "popstate",
          (event) => {
            const local = new CustomEvent("haneoka:detail-popstate", { cancelable: true });
            window.dispatchEvent(local);
            if (local.defaultPrevented) event.stopImmediatePropagation();
          },
          true,
        );
      }
    </script>
    <ClientRouter fallback="none" />
    <script is:inline>
      (() => {
        const d = document.documentElement;
        try {
          const p = localStorage.getItem("haneoka.ui-theme.v1") || "system",
            r = p === "system" ? (matchMedia("(prefers-color-scheme:dark)").matches ? "dark" : "light") : p;
          d.dataset.theme = r;
          d.dataset.themePreference = p;
        } catch {}
        try {
          const s = localStorage.getItem("haneoka.ui-seed.v1");
          d.dataset.seed = /^(haneoka|band-[1-5])$/.test(s || "") ? s : "haneoka";
          d.dataset.nav = localStorage.getItem("haneoka.navigation.expanded.v2") === "false" ? "collapsed" : "expanded";
          d.dataset.density = localStorage.getItem("haneoka.ui-density.v1") === "compact" ? "compact" : "comfortable";
        } catch {
          d.dataset.seed = "haneoka";
          d.dataset.nav = "expanded";
          d.dataset.density = "comfortable";
        }
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={pageSummary} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="haneoka" />
    <meta property="og:title" content={fullTitle} />
    <meta
      property="og:description"
      content={pageSummary}

    />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:image" content={`${origin}/images/haneoka-social-card.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta
      name="twitter:description"
      content={pageSummary}

    />
    <meta name="twitter:image" content={`${origin}/images/haneoka-social-card.png`} />
    <meta name="theme-color" content="#f0edf1" />
    <meta name="color-scheme" content="light dark" />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonicalHref} />
    {!noindex &&
      languageAlternates.map((alternate) => (
        <link rel="alternate" hreflang={localeTag(alternate.locale)} href={alternate.href} />
      ))}
    {!noindex && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={languageAlternates.find((alternate) => alternate.locale === "en")?.href}
      />
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <slot name="head" />
    {!noindex && (
      <script
        type="application/ld+json"
        is:inline
        set:html={structuredData}
      ></script>
    )}
  </head>
  <body>
    <slot />
    <audio-dock transition:persist="haneoka-audio"></audio-dock>
    <script>
      import { installI18nDom } from "../i18n/dom";
      installI18nDom();
    </script>
    <script>
      if ("serviceWorker" in navigator)
        addEventListener("load", () => navigator.serviceWorker.register("/sw.js").catch(() => {}), { once: true });
    </script>
    <script>
      const restoreAudioDock = async () => {
        try {
          const value = JSON.parse(localStorage.getItem("haneoka:audio:v2") || "null");
          if (!Array.isArray(value?.queue) || !value.queue.length) return;
          if (!customElements.get("audio-dock")) await import("../lit/runtime/audio-dock");
          if (!document.querySelector("audio-dock")) {
            const dock = document.createElement("audio-dock");
            dock.setAttribute("data-astro-transition-persist", "haneoka-audio");
            document.body.append(dock);
          }
        } catch {}
      };
      void restoreAudioDock();
      document.addEventListener("astro:page-load", restoreAudioDock);
    </script>
    <script>
      import { SEED_KEY, isSeed, syncThemeColor } from "../lib/tuning";
      import { installRipple } from "../lib/ripple";
      import { installLoadingProgress } from "../lib/loading-progress";
      installLoadingProgress();
      installRipple();
      // Page changes swap instantly: no view-transition name is projected onto
      // the content pane, so there is no cross-fade to watch between routes.
      type ThemeWindow = Window & { __haneokaApplyTheme?: () => void };
      const themeMedia = matchMedia("(prefers-color-scheme: dark)");
      const applyTheme = () => {
        let preference = "system";
        try {
          preference = localStorage.getItem("haneoka.ui-theme.v1") || "system";
        } catch {}
        if (!["light", "dark", "system"].includes(preference)) preference = "system";
        const resolved = preference === "system" ? (themeMedia.matches ? "dark" : "light") : preference;
        const root = document.documentElement;
        root.dataset.theme = resolved;
        root.dataset.themePreference = preference;
        syncThemeColor();
      };
      (window as ThemeWindow).__haneokaApplyTheme = applyTheme;
      applyTheme();
      if (document.documentElement.dataset.themeListener !== "true") {
        document.documentElement.dataset.themeListener = "true";
        themeMedia.addEventListener("change", () => {
          let preference = "system";
          try {
            preference = localStorage.getItem("haneoka.ui-theme.v1") || "system";
          } catch {}
          if (preference === "system") applyTheme();
        });
      }
      document.addEventListener("astro:before-swap", (event) => {
        const transition = event as Event & { newDocument: Document; to?: URL };
        const next = transition.newDocument;
        if (!next) return;
        if (transition.to) next.documentElement.dataset.navigationHref = transition.to.href;
        next.documentElement.dataset.theme = document.documentElement.dataset.theme || "light";
        next.documentElement.dataset.themePreference = document.documentElement.dataset.themePreference || "system";
        next.documentElement.dataset.nav = document.documentElement.dataset.nav || "expanded";
        next.documentElement.dataset.density = document.documentElement.dataset.density || "comfortable";
        let seed = document.documentElement.dataset.seed;
        try {
          seed = localStorage.getItem(SEED_KEY) || seed;
        } catch {}
        next.documentElement.dataset.seed = isSeed(seed) ? seed : "haneoka";
      });
      document.addEventListener("astro:after-swap", () => {
        delete document.documentElement.dataset.navigationHref;
        applyTheme();
      });
    </script>
  </body>
</html>
