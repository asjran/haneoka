---
import AssetsDocument from "../../../../components/AssetsDocument.astro";
import { LOCALES, type Locale } from "../../../../i18n/locales";
import { RELEASE_SERVERS, type ReleaseServer } from "../../../../lib/release-server";

export function getStaticPaths() {
  return RELEASE_SERVERS.flatMap((server) => LOCALES.map((locale) => ({ params: { server, locale } })));
}

const { server, locale } = Astro.params as { server: ReleaseServer; locale: Locale };
---

<AssetsDocument locale={locale} server={server} />
