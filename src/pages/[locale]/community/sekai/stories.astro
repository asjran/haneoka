---
import Base from "../../../../layouts/Base.astro";
import AppShell from "../../../../components/AppShell.astro";
import { LOCALES, type Locale } from "../../../../i18n/locales";
import { t } from "../../../../i18n/messages";
import "../../../../lit/story-workspace";
import "../../../../styles/catalog.css";
import "../../../../styles/story.css";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props as { locale: Locale };
const route = "/community/sekai/stories";
const titleKey = "community.page.sekai.storiesTitle";
const title = t(locale, titleKey, "Project Sekai event stories");
---

<Base locale={locale} route={route} title={title} titleKey={titleKey} description={title}>
  <AppShell locale={locale} route={route} title={title} titleKey={titleKey}>
    <story-workspace locale={locale} mode="event" origin="sekai"></story-workspace>
  </AppShell>
</Base>
<script>
  import "../../../../lit/story-workspace";
</script>
