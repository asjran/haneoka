---
import Base from "../../../../layouts/Base.astro";
import AppShell from "../../../../components/AppShell.astro";
import { LOCALES, type Locale } from "../../../../i18n/locales";
import { t } from "../../../../i18n/messages";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props as { locale: Locale };
const route = "/community/sekai";
const title = t(locale, "community.page.sekai.title", "Project Sekai songs");
const entity = { title, backHref: `/${locale}/community/sekai/` };
---

<Base locale={locale} route={route} title={title} description={title} noindex>
  <AppShell locale={locale} route={route} title={title} entity={entity}>
    <sekai-songs locale={locale} mode="detail"></sekai-songs>
  </AppShell>
</Base>
<script>
  import "../../../../lit/sekai-songs";
</script>
