---
import Base from "../../../layouts/Base.astro";
import AppShell from "../../../components/AppShell.astro";
import { LOCALES, type Locale } from "../../../i18n/locales";
import { t } from "../../../i18n/messages";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props as { locale: Locale };
const route = "/community/sekai";
const titleKey = "community.page.sekai.title";
const title = t(locale, titleKey, "Project Sekai songs");
---

<Base locale={locale} route={route} title={title} titleKey={titleKey} description={title}>
  <AppShell locale={locale} route={route} title={title} titleKey={titleKey}>
    <sekai-songs locale={locale} mode="list"></sekai-songs>
  </AppShell>
</Base>
<script>
  import "../../../lit/sekai-songs";
</script>
