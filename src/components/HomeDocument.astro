---
import Base from "../layouts/Base.astro";
import AppShell from "./AppShell.astro";
import HomePage from "./pages/HomePage.astro";
import { t } from "../i18n/messages";
import type { Locale } from "../i18n/locales";
const { locale } = Astro.props as { locale: Locale };
const title = t(locale, "homePage.overview", "haneoka");
const seoTitle = t(locale, "seo.homeTitle", "BanG Dream! Our Notes Archive");

---

<Base locale={locale} route="/" title={title} titleKey="homePage.overview" seoTitleValues={{ [locale]: seoTitle }}>
  <AppShell locale={locale} route="/" title={title} titleKey="homePage.overview">
    <HomePage locale={locale} />
  </AppShell>
</Base>
