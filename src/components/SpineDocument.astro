---
import Base from "../layouts/Base.astro";
import AppShell from "./AppShell.astro";
import type { Locale } from "../i18n/locales";
import { t } from "../i18n/messages";
import { resourcePath } from "../lib/resource-route";
import type { ReleaseServer } from "../lib/release-server";
import { serializePageData } from "../lib/page-data";
import { workspaceCollectionData } from "../server/workspace-page-data";
import { renderCollectionWorkspace } from "../server/render-collection-workspaces";
import "../styles/catalog.css";
import "../styles/viewer.css";
const { locale, server } = Astro.props as { locale: Locale; server?: ReleaseServer };
const title = t(locale, "navigation.spine", "Spine");
const payload = await workspaceCollectionData("spine", server || "intl", locale);
const page = await renderCollectionWorkspace(payload, locale);
const dataId = "spine-collection-" + payload.server + "-" + locale;
---
<Base locale={locale} route="/catalog/spine" canonicalRoute={server ? resourcePath({ server, locale, kind: "spine" }) : undefined} title={title} titleKey="navigation.spine">
  <AppShell locale={locale} route="/catalog/spine" title={title} titleKey="navigation.spine" server={server} appBar={page.appBar}>
    <script is:inline type="application/json" id={dataId} set:html={serializePageData(payload)}></script>
    <spine-workspace locale={locale} data-page-data={dataId} data-prerendered set:html={page.body}></spine-workspace>
  </AppShell>
</Base>
<script>import "../lit/spine-workspace";</script>
