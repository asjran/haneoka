---
import type { Locale } from "../../i18n/locales";
import type { ReleaseServer } from "../../lib/release-server";
import { serializePageData } from "../../lib/page-data";
import { eventTrackerPageData } from "../../server/event-tracker-page-data";
import { renderEventTracker } from "../../server/render-event-tracker";
import type { TrackerPageData } from "../../lib/event-tracker-page-data";
import type { StaticWorkspacePage } from "../../server/render-workspace";
import "../../styles/song-ranking.css";

const { locale, server = "intl", payload: preparedPayload, page: preparedPage } = Astro.props as { locale: Locale; server?: ReleaseServer; payload?: TrackerPageData; page?: StaticWorkspacePage };
const dataId = `event-tracker-cards-${server}`;
const payload = preparedPayload || await eventTrackerPageData();
const page = preparedPage || await renderEventTracker(payload, locale, server);
---

<event-tracker locale={locale} server={server} data-page-data={dataId} data-prerendered set:html={page.body}></event-tracker>
<script is:inline type="application/json" id={dataId} set:html={serializePageData(payload)}></script>
<script>
  import "../../lit/event-tracker";
</script>
