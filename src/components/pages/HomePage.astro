---
import { localePath, type Locale } from "../../i18n/locales";
import { t } from "../../i18n/messages";
import CatalogIndexPage from "./CatalogIndexPage.astro";
import Icon from "../Icon.astro";
import I18nText from "../I18nText.astro";
import type { ReleaseServer } from "../../lib/release-server";
import { renderHome } from "../../server/render-home";
const { locale, server = "intl" } = Astro.props as { locale: Locale; server?: ReleaseServer };
const home = await renderHome(server, locale);
---

<home-dashboard locale={locale} server={server} data-prerendered>
  <Fragment set:html={home.html} />
  {home.seed && <script type="application/json" data-home-seed set:html={home.seed} />}
</home-dashboard>
<script is:inline>
  (() => {
    const home = document.currentScript?.previousElementSibling;
    const board = home?.querySelector(".home-board");
    if (!board) return;
    const ids = ["birthdays", "news", "community", "fanInfo", "cards", "songs"];
    const storageKey = "haneoka:home-layout:v5";
    let order = [...ids];
    let hidden = {};
    try {
      const state = JSON.parse(localStorage.getItem(storageKey) || localStorage.getItem("haneoka:home-layout:v4") || "null");
      if (
        Array.isArray(state?.order) &&
        new Set(state.order).size === state.order.length &&
        state.order.every(id => ids.includes(id)) &&
        ids.filter(id => id !== "fanInfo").every(id => state.order.includes(id))
      ) {
        order = [...state.order, ...ids.filter(id => !state.order.includes(id))];
      }
      if (state?.hidden && typeof state.hidden === "object") hidden = state.hidden;
      const rest = order.filter(id => id !== "news" && id !== "community" && id !== "fanInfo");
      const position = Math.min(order.indexOf("news"), order.indexOf("community"));
      rest.splice(Math.max(0, position), 0, "news", "community", "fanInfo");
      order = rest;
    } catch {
    }
    for (const id of order) {
      const slot = board.querySelector(`.home-board__slot--${id}`);
      if (slot) board.append(slot);
    }
    for (const id of ids) {
      const slot = board.querySelector(`.home-board__slot--${id}`);
      if (slot) slot.hidden = Boolean(hidden[id]);
    }
  })();
</script>
<script>
  import "../../lit/home-dashboard";
</script>
<CatalogIndexPage locale={locale} server={server} />
<footer class="home-footer">
  <p>haneoka · <I18nText keyName="homePage.fanArchive" fallback="Unofficial archive and community" locale={locale} /></p>
  <nav aria-label={t(locale, "homePage.legalNavigation", "Policies and project information")}>
    <a class="text-link" href="https://bdon.moe" target="_blank" rel="noreferrer"><Icon name="favorite" size={14} /> MoeNotes <Icon name="open_in_new" size={14} /></a>
    <a class="text-link" href={localePath("/privacy", locale)}><I18nText keyName="privacy" fallback="Privacy Policy" locale={locale} /></a>
    <a class="text-link" href={localePath("/terms", locale)}><I18nText keyName="terms" fallback="Terms of Use" locale={locale} /></a>
    <a class="text-link" href={localePath("/about", locale)}><I18nText keyName="about" fallback="About" locale={locale} /></a>
  </nav>
</footer>
<style is:global>
  @import "../../styles/home.css";
</style>
