---
import Base from "../layouts/Base.astro";
import AppShell from "./AppShell.astro";
import type { Locale } from "../i18n/locales";
import { t } from "../i18n/messages";
import "../lit/admin-workspace";
import "../styles/admin.css";
const { locale, section = "overview" } = Astro.props as { locale: Locale; section?: string };
const title = t(locale, "adminPage.title", "Admin");

---
<Base locale={locale} route={`/admin/${section}`} title={title} titleKey="adminPage.title">
  <AppShell locale={locale} route={`/admin/${section}`} title={title} titleKey="adminPage.title">
    <admin-workspace section={section}></admin-workspace>
  </AppShell>
</Base>
<script>import "../lit/admin-workspace";</script>
