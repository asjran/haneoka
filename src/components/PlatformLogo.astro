---
import { svg as android } from "@thesvg/icons/android";
import { svg as windows } from "@thesvg/icons/windows";
import { svg as apple } from "@thesvg/icons/apple";
import { svg as linux } from "@thesvg/icons/linux";
interface Props { platform: string; }
const { platform } = Astro.props;
const logos: Record<string, string> = { android, windows, macos: apple, ios: apple, linux };
const svg = logos[platform];
---
<span class="platform-logo" aria-hidden="true">
  {platform === "macos" || platform === "ios" ? <Fragment set:html={apple.replaceAll('#fff', 'currentColor')} /> : <img src={`data:image/svg+xml,${encodeURIComponent(svg)}`} width="32" height="32" alt="" />}
</span>
<style>
  .platform-logo { display: inline-flex; align-items: center; justify-content: center; width: var(--platform-logo-size, 24px); height: var(--platform-logo-size, 24px); flex: 0 0 auto; }
  .platform-logo :global(svg), .platform-logo img { width: 100%; height: 100%; object-fit: contain; }
</style>
