---
import Base from "../layouts/Base.astro";
import AppShell from "./AppShell.astro";
import type { Locale } from "../i18n/locales";
import { t } from "../i18n/messages";
import type { ReleaseServer } from "../lib/release-server";
import { assetPageData, assetViewData, serializedAssetPage } from "../server/asset-page-data";
import { renderAssets } from "../server/render-assets";
import { serializePageData } from "../lib/page-data";
import { assetPublicDocumentUrl } from "../lib/asset-static-routing";
import { STATIC_DOCUMENT_UNDERLAY_START, STATIC_DOCUMENT_UNDERLAY_END } from "../lib/static-documents";
import "../styles/catalog.css";
import "../styles/tools.css";
const { locale, server, path = [], selected = "" } = Astro.props as { locale: Locale; server?: ReleaseServer; path?: string[]; selected?: string };
const title = t(locale, "navigation.assets", "Assets");
const canonicalRoute = server ? assetPublicDocumentUrl({ server: server as "jp" | "intl", locale, path, selected: "" }) : undefined;
const payload = await assetPageData(server || "intl");
const view = await assetViewData(server || "intl", locale, path, selected);
const page = await renderAssets(payload, locale, view);
---
<Base noindex locale={locale} route="/catalog/assets" canonicalRoute={canonicalRoute} title={title} titleKey="navigation.assets">
  <AppShell locale={locale} route="/catalog/assets" title={title} titleKey="navigation.assets" server={server} appBar={page.appBar}>
    <Fragment set:html={STATIC_DOCUMENT_UNDERLAY_START} />
    <script is:inline type="application/json" id="asset-page-data" set:html={serializedAssetPage(payload)}></script>
    <Fragment set:html={STATIC_DOCUMENT_UNDERLAY_END} />
    <script is:inline type="application/json" id="asset-view-data" set:html={serializePageData(view)}></script>
    <asset-explorer data-page-data="asset-page-data" data-view-data="asset-view-data" data-prerendered set:html={page.body}></asset-explorer>
  </AppShell>
</Base>
<script>
  import "../lit/asset-explorer";
</script>
