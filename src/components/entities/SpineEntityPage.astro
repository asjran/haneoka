---
import Base from "../../layouts/Base.astro";
import AppShell from "../../components/AppShell.astro";
import { findRoute, titleOf } from "../../config/routes";
import { LOCALES, type Locale } from "../../i18n/locales";
import { serializePageData } from "../../lib/page-data";
import type { SearchableModelPage } from "../../lib/searchable-models";
import { resourcePath, type EntityLink } from "../../lib/resource-route";
import type { ReleaseServer } from "../../lib/release-server";
import "../../lit/spine-workspace";
import "../../styles/catalog.css";
import "../../styles/viewer.css";

interface Props {
  page: SearchableModelPage;
  locale: Locale;
  server?: ReleaseServer;
  canonical?: boolean;
  returnTo?: string;
  previous?: EntityLink;
  next?: EntityLink;
}
const { page, locale, server = "intl", canonical = false, returnTo, previous, next } = Astro.props;
const sectionRoute = "/catalog/spine";
const sectionRouteDefinition = findRoute(sectionRoute);
if (!sectionRouteDefinition) throw new Error(`Missing route definition for ${sectionRoute}`);
const sectionTitle = titleOf(sectionRouteDefinition, locale);
const canonicalHref = resourcePath({ server, locale, kind: "spine", id: page.id });
const route = canonical ? canonicalHref : `${sectionRoute}/${page.id}`;
const pageDataId = `model-page-${page.kind}-${page.id}`;
const payload = { schema: "haneoka-model-page-v1", id: page.id, server, model: page.model };
const preview = page.model.preview as Record<string, unknown> | undefined;
const previewWidth = Number(preview?.width || preview?.imageWidth || preview?.naturalWidth || 0);
const previewHeight = Number(preview?.height || preview?.imageHeight || preview?.naturalHeight || 0);
const previewRatio = Number(preview?.aspectRatio || preview?.ratio || 0);
const stageRatio =
  Number.isFinite(previewWidth) && Number.isFinite(previewHeight) && previewWidth > 0 && previewHeight > 0
    ? `${previewWidth} / ${previewHeight}`
    : Number.isFinite(previewRatio) && previewRatio > 0 ? String(previewRatio) : "3 / 4";
const seoTitleValues = Object.fromEntries(
  LOCALES.map((target) => {
    const subtitle = page.subtitles[target];
    return [
      target,
      [page.titles[target], subtitle && subtitle !== page.titles[target] ? subtitle : "", sectionTitle]
        .filter(Boolean)
        .join(" · "),
    ];
  }),
) as Record<Locale, string>;
---

<Base
  locale={locale}
  route={route}
  canonicalRoute={canonical ? canonicalHref : undefined}
  title={sectionTitle}
  titleKey={sectionRouteDefinition.titleKey}
  description={page.descriptions[locale]}
  seoTitleValues={seoTitleValues}
  seoDescriptionValues={page.descriptions}
  searchImage={page.image}
  searchTitle={page.titles[locale]}
>
  <AppShell
    locale={locale}
    route={sectionRoute}
    server={server}
    title={canonical ? page.titles[locale] : sectionTitle}
    titleKey={canonical ? undefined : sectionRouteDefinition.titleKey}
    entity={
      canonical
        ? {
            title: page.titles[locale],
            backHref: returnTo || resourcePath({ server, locale, kind: "spine" }),
            previous,
            next,
          }
        : undefined
    }
  >
    <script type="application/json" id={pageDataId} set:html={serializePageData(payload)}></script>
    <spine-workspace
      data-page-data={pageDataId}
      locale={locale}
      entity-id={canonical ? page.id : undefined}
      preview-src={canonical ? page.image : undefined}
    >
      {canonical && (
        <figure class="viewer-ssr-stage" style={`--viewer-stage-ratio: ${stageRatio}`} aria-label={page.titles[locale]}>
          {page.image ? (
            <img src={page.image} alt="" aria-hidden="true" decoding="async" />
          ) : (
            <span class="viewer-stage__placeholder" aria-hidden="true"></span>
          )}
        </figure>
      )}
    </spine-workspace>
  </AppShell>
</Base>
<script>
  import "../../lit/spine-workspace";
</script>
