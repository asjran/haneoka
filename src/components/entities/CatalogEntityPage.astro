---
import Base from "../../layouts/Base.astro";
import AppShell from "../AppShell.astro";
import { catalogConfig } from "../../config/catalog-labels";
import { findRoute, titleOf } from "../../config/routes";
import { LOCALES, type Locale } from "../../i18n/locales";
import { t } from "../../i18n/messages";
import {
  resourceKindForCollection,
  chartPath,
  resourcePath,
  type EntityLink,
  type ResourceKind,
} from "../../lib/resource-route";
import type { ReleaseServer } from "../../lib/release-server";
import type { SearchableCatalogPage } from "../../lib/searchable-catalog";
import "../../lit/catalog-screen";
import "../../styles/catalog.css";
import { renderCatalog } from "../../server/render-catalog";
import { catalogEntityData, type EntityPayload } from "../../lib/entity-graph";
import { serializePageData } from "../../lib/page-data";

interface Props {
  page: SearchableCatalogPage;
  locale: Locale;
  server?: ReleaseServer;
  canonical?: boolean;
  returnTo?: string;
  previous?: EntityLink;
  next?: EntityLink;
  chartPage?: boolean;
}
const { page, locale, server = "intl", canonical = false, returnTo, previous, next, chartPage = false } = Astro.props;
const collectionRoute = findRoute(page.route);
if (!collectionRoute) throw new Error(`Missing route definition for ${page.route}`);
const sectionTitle = titleOf(collectionRoute, locale);
const kind = resourceKindForCollection(page.collection) as ResourceKind;
const parentHref = resourcePath({ server, locale, kind, id: page.id });
const canonicalHref = chartPage ? chartPath({ server, locale, id: page.id }) : parentHref;
const route = canonical ? canonicalHref : `${page.route}/${page.id}`;
const backHref = returnTo || (chartPage ? parentHref : resourcePath({ server, locale, kind }));
const seoTitleValues = Object.fromEntries(
  LOCALES.map((target) => {
    const localizedSection = titleOf(collectionRoute, target);
    const subtitle = page.subtitles[target];
    return [
      target,
      `${page.titles[target]}${subtitle && subtitle !== page.titles[target] ? ` · ${subtitle}` : ""} · ${localizedSection}`,
    ];
  }),
) as Record<Locale, string>;
const payload = await catalogEntityData(server,page.resource,page.id) as EntityPayload | undefined;
if(!payload)throw new Error(`Missing page data: ${server}/${page.resource}/${page.id}`);
const pageDataId=`catalog-page-${page.resource}-${page.id}`;
const screenConfig = catalogConfig({
  resource: page.resource,
  locale,
  server,
  entityKind: kind,
  ...(canonical ? { entityId: page.id, entityContext: true } : {}),
  ...(chartPage ? { chartPage: true } : {}),
  aspectRatio: page.resource === "cards" ? "224 / 294" : "1",
});
const body = await renderCatalog(screenConfig,payload,locale);
const entity = canonical
  ? {
      title: page.titles[locale],
      backHref,
      previous,
      next,
    }
  : undefined;
---

<Base
  locale={locale}
  route={route}
  canonicalRoute={canonical ? canonicalHref : undefined}
  noindex={chartPage}
  title={sectionTitle}
  titleKey={collectionRoute.titleKey}
  description={page.descriptions[locale]}
  seoTitleValues={seoTitleValues}
  seoDescriptionValues={page.descriptions}
  searchImage={page.image}
  searchTitle={page.titles[locale]}
>
  <AppShell
    locale={locale}
    route={page.route}
    server={server}
    title={canonical ? page.titles[locale] : sectionTitle}
    titleKey={canonical ? undefined : collectionRoute.titleKey}
    entity={entity}
  >
    <script type="application/json" id={pageDataId} set:html={serializePageData(payload)}></script>
    <catalog-screen config={screenConfig} data-prerendered data-page-data={pageDataId} set:html={body}></catalog-screen>
  </AppShell>
</Base>
<script>
  import "../../lit/catalog-screen";
</script>
