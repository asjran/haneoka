---
import Base from "../layouts/Base.astro";
import AppShell from "./AppShell.astro";
import { t } from "../i18n/messages";
import type { Locale } from "../i18n/locales";
import type { ReleaseServer } from "../lib/resource-route";
import { skillCatalogPayload } from "../server/skill-catalog";
import { serializePageData } from "../lib/page-data";
import { renderSkillsWorkspace } from "../server/render-skills";
import "../styles/catalog.css";
const { locale, server } = Astro.props as { locale: Locale; server: ReleaseServer };
const title = t(locale, "catalog.cards.fields.skills", "Skills");
const payload = await skillCatalogPayload(server);
const page = await renderSkillsWorkspace(payload, locale);
---
<Base locale={locale} route="/catalog/skills" canonicalRoute={`/${server}/${locale}/skills/`} title={title} titleKey="catalog.cards.fields.skills">
  <AppShell locale={locale} route="/catalog/skills" title={title} titleKey="catalog.cards.fields.skills" server={server} appBar={page.appBar}>
    <script is:inline type="application/json" id="skill-catalog-data" set:html={serializePageData(payload)}></script>
    <skills-workspace locale={locale} data-page-data="skill-catalog-data" data-prerendered set:html={page.body}></skills-workspace>
  </AppShell>
</Base>
<script>import "../lit/skills-workspace";</script>
