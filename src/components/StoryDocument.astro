---
import Base from "../layouts/Base.astro";
import AppShell from "./AppShell.astro";
import type { Locale } from "../i18n/locales";
import { t } from "../i18n/messages";
import { storyCollectionPath, type StoryMode } from "../lib/resource-route";
import type { ReleaseServer } from "../lib/release-server";
import { serializePageData } from "../lib/page-data";
import { workspaceCollectionData } from "../server/workspace-page-data";
import { renderCollectionWorkspace } from "../server/render-collection-workspaces";
import "../styles/catalog.css";
import "../styles/story.css";
const { locale, mode = "band", server } = Astro.props as { locale: Locale; mode?: StoryMode; server?: ReleaseServer };
const route = "/catalog/stories/" + mode;
const canonicalRoute = server ? storyCollectionPath({ server, locale, mode }) : undefined;
const titleKey = mode === "birthday" ? "story.labels.birthdayStory" : "story.navigation." + mode;
const title = t(locale, titleKey, mode);
const payload = await workspaceCollectionData("stories", server || "intl", locale);
const page = await renderCollectionWorkspace(payload, locale, mode);
const dataId = "story-collection-" + payload.server + "-" + locale + "-" + mode;
---
<Base locale={locale} route={route} canonicalRoute={canonicalRoute} title={title} titleKey={titleKey}>
  <AppShell locale={locale} route={route} title={title} titleKey={titleKey} server={server} appBar={page.appBar}>
    <script is:inline type="application/json" id={dataId} set:html={serializePageData(payload)}></script>
    <story-workspace locale={locale} mode={mode} data-page-data={dataId} data-prerendered set:html={page.body}></story-workspace>
  </AppShell>
</Base>
<script>import "../lit/story-workspace";</script>
