---
import type { Locale } from "../i18n/locales";
import { serverMessage } from "../i18n/server";

interface Props {
  keyName: string;
  fallback?: string;
  locale?: Locale;
  as?: keyof HTMLElementTagNameMap;
}

const { keyName, fallback = keyName, locale = "ja", as: Tag = "span" }: Props = Astro.props;
const message = serverMessage(locale, keyName, undefined, fallback);
---

<Tag lang={message.lang} data-i18n={keyName} data-i18n-fallback={fallback}>{message.text}</Tag>
