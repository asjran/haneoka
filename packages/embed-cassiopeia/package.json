{
  "name": "@haneoka/embed-cassiopeia",
  "version": "0.1.0",
  "description": "Mount a standalone Cassiopeia chart player with hosted or authored content",
  "type": "module",
  "license": "MPL-2.0",
  "sideEffects": [
    "./dist/style.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./haneoka": {
      "types": "./dist/haneoka.d.ts",
      "import": "./dist/haneoka.js",
      "default": "./dist/haneoka.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-style.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@haneoka/embed-core": "^0.1.0"
  },
  "peerDependencies": {
    "@haneoka/cassiopeia": "^0.1.0",
    "@haneoka/cassiopeia-host-web": "^0.1.0",
    "@haneoka/cassiopeia-plugin-our-notes": "^0.1.0",
    "@haneoka/cassiopeia-renderer-three": "^0.1.0",
    "@haneoka/cassiopeia-ui-vue": "^0.1.0",
    "@haneoka/api-client": "^0.1.0",
    "vue": ">=3.5.0 <4",
    "three": ">=0.184.0 <0.185.0"
  },
  "peerDependenciesMeta": {
    "@haneoka/cassiopeia-plugin-our-notes": {
      "optional": true
    },
    "@haneoka/cassiopeia-renderer-three": {
      "optional": true
    },
    "@haneoka/cassiopeia-ui-vue": {
      "optional": true
    },
    "@haneoka/api-client": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haneoka-gakuen/haneoka.git",
    "directory": "packages/embed-cassiopeia"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
